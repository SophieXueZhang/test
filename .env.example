# n8n Configuration
N8N_USER=admin
N8N_PASSWORD=change_me_please
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678
TIMEZONE=Asia/Shanghai

# Database Configuration
POSTGRES_USER=n8n
POSTGRES_PASSWORD=n8n_password
POSTGRES_DB=n8n

# Redis Configuration
REDIS_PASSWORD=redis_password

# MinIO Configuration (Object Storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# AI Service API Keys
# OpenAI (for GPT-4 Vision, DALL-E)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Stability AI (for Stable Diffusion)
STABILITY_API_KEY=sk-your-stability-api-key-here

# Replicate (alternative AI models)
REPLICATE_API_KEY=r8_your-replicate-api-key-here

# Hugging Face (for various models)
HUGGINGFACE_API_KEY=hf_your-huggingface-api-key-here

# Image Processing Settings
MAX_IMAGE_SIZE=10485760  # 10MB in bytes
ALLOWED_FORMATS=jpg,jpeg,png,webp
OUTPUT_FORMAT=png
OUTPUT_QUALITY=90
