        [
          {
            "node": "分批处理",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "分批处理": {
      "main": [
        [
          {
            "node": "调用生成工作流",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "调用生成工作流": {
      "main": [
        [
          {
