{
  "name": "T恤设计生成器",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "generate-tshirt-design",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "3e3e3e3e-1111-1111-1111-111111111111",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ],
      "webhookId": "tshirt-design-webhook"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4-vision-preview\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": [\n        {\n          \"type\": \"text\",\n          \"text\": \"请分析这个T恤设计图片，用JSON格式返回以下信息：{\\\"style\\\": \\\"设计风格\\\", \\\"colors\\\": [\\\"颜色1\\\", \\\"颜色2\\\"], \\\"elements\\\": [\\\"元素1\\\", \\\"元素2\\\"], \\\"layout\\\": \\\"布局描述\\\", \\\"audience\\\": \\\"目标受众\\\"}\"\n        },\n        {\n          \"type\": \"image_url\",\n          \"image_url\": {\n            \"url\": \"={{ $json.body.imageUrl }}\"\n          }\n        }\n      ]\n    }\n  ],\n  \"max_tokens\": 1000\n}",
        "options": {}
      },
      "id": "3e3e3e3e-2222-2222-2222-222222222222",
      "name": "分析图片-GPT4",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        470,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// 解析GPT-4的分析结果并生成Stable Diffusion提示词\nconst response = $input.first().json;\nlet analysis;\n\ntry {\n  // 尝试解析 GPT-4 返回的内容\n  const content = response.choices[0].message.content;\n  analysis = JSON.parse(content);\n} catch (e) {\n  // 如果解析失败，使用默认值\n  analysis = {\n    style: \"modern minimalist\",\n    colors: [\"black\", \"white\"],\n    elements: [\"graphic design\"],\n    layout: \"centered\",\n    audience: \"casual wear\"\n  };\n}\n\n// 构建详细的提示词\nconst prompt = `Professional t-shirt design, ${analysis.style} style, featuring ${analysis.elements.join(', ')}, color scheme: ${analysis.colors.join(', ')}, ${analysis.layout} layout, for ${analysis.audience}, high quality, 4K, clean background, vector art style, professional mockup`;\n\nconst negativePrompt = `low quality, blurry, pixelated, distorted, watermark, text, signature, bad anatomy, poorly drawn, amateur, messy`;\n\n// 设置生成参数\nreturn [{\n  json: {\n    prompt: prompt,\n    negative_prompt: negativePrompt,\n    analysis: analysis,\n    seed: Math.floor(Math.random() * 999999),\n    steps: 30,\n    cfg_scale: 7,\n    width: 1024,\n    height: 1024,\n    samples: 1\n  }\n}];"
      },
      "id": "3e3e3e3e-3333-3333-3333-333333333333",
      "name": "生成提示词",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        690,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.stability.ai/v1/generation/stable-diffusion-xl-1024-v1-0/text-to-image",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text_prompts\": [\n    {\n      \"text\": \"{{ $json.prompt }}\",\n      \"weight\": 1\n    },\n    {\n      \"text\": \"{{ $json.negative_prompt }}\",\n      \"weight\": -1\n    }\n  ],\n  \"cfg_scale\": {{ $json.cfg_scale }},\n  \"height\": {{ $json.height }},\n  \"width\": {{ $json.width }},\n  \"samples\": {{ $json.samples }},\n  \"steps\": {{ $json.steps }},\n  \"seed\": {{ $json.seed }}\n}",
        "options": {}
      },
      "id": "3e3e3e3e-4444-4444-4444-444444444444",
      "name": "生成图片-StabilityAI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        910,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// 处理生成的图片数据\nconst response = $input.first().json;\n\nif (!response.artifacts || response.artifacts.length === 0) {\n  throw new Error('No image generated');\n}\n\nconst artifact = response.artifacts[0];\nconst imageData = artifact.base64;\nconst filename = `tshirt-design-${Date.now()}.png`;\n\nreturn [{\n  json: {\n    filename: filename,\n    imageData: imageData,\n    seed: artifact.seed,\n    finishReason: artifact.finishReason\n  }\n}];"
      },
      "id": "3e3e3e3e-5555-5555-5555-555555555555",
      "name": "处理图片数据",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1130,
        300
      ]
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "=/data/output/{{ $json.filename }}",
        "dataPropertyName": "imageData",
        "options": {
          "encoding": "base64"
        }
      },
      "id": "3e3e3e3e-6666-6666-6666-666666666666",
      "name": "保存文件",
      "type": "n8n-nodes-base.writeFile",
      "typeVersion": 1,
      "position": [
        1350,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"message\": \"T恤设计生成成功\",\n  \"data\": {\n    \"filename\": \"{{ $json.filename }}\",\n    \"seed\": {{ $json.seed }},\n    \"timestamp\": \"{{ $now.toISO() }}\"\n  }\n}",
        "options": {}
      },
      "id": "3e3e3e3e-7777-7777-7777-777777777777",
      "name": "返回结果",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1570,
        300
      ]
    }
  ],
