# AI情感陪伴系统 - 环境变量配置
# 复制此文件为 .env 并填入真实的配置值

# ============================================
# n8n配置
# ============================================
N8N_USER=admin
N8N_PASSWORD=change_this_password_123
N8N_HOST=localhost
N8N_PORT=5678

# ============================================
# 数据库配置
# ============================================
POSTGRES_DB=ai_companion
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_password_456
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ============================================
# Redis配置
# ============================================
REDIS_PASSWORD=change_this_password_789
REDIS_HOST=localhost
REDIS_PORT=6379

# ============================================
# MinIO对象存储配置
# ============================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_this_password_101112
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET_AUDIO=ai-companion-audio
MINIO_BUCKET_IMAGES=ai-companion-images

# ============================================
# OpenAI API配置
# ============================================
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.7

# OpenAI TTS配置
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova  # alloy, echo, fable, onyx, nova, shimmer

# OpenAI Whisper配置
OPENAI_WHISPER_MODEL=whisper-1

# ============================================
# Azure Speech Services配置（可选，替代OpenAI TTS）
# ============================================
AZURE_SPEECH_KEY=your-azure-speech-key-here
AZURE_SPEECH_REGION=eastasia
AZURE_TTS_VOICE=zh-CN-XiaoxiaoNeural  # 晓晓（温柔女声）
# 其他可选语音：
# zh-CN-YunxiNeural (云希-男声)
# zh-CN-XiaoyiNeural (晓伊-女声)
# zh-CN-YunjianNeural (云健-男声)

# ============================================
# 国产大模型配置（可选替代OpenAI）
# ============================================
# 讯飞星火
XFYUN_API_KEY=
XFYUN_API_SECRET=
XFYUN_APP_ID=

# 阿里通义千问
DASHSCOPE_API_KEY=

# 百度文心一言
QIANFAN_ACCESS_KEY=
QIANFAN_SECRET_KEY=

# ============================================
# 向量数据库配置
# ============================================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=  # 可选
QDRANT_COLLECTION_NAME=ai_companion_memories

# ============================================
# 微信小程序配置
# ============================================
WECHAT_APP_ID=your-wechat-appid
WECHAT_APP_SECRET=your-wechat-appsecret

# ============================================
# 安全配置
# ============================================
# JWT密钥（用于API认证）
JWT_SECRET_KEY=change_this_to_a_random_secret_key_67890

# 加密密钥（用于敏感数据加密）
ENCRYPTION_KEY=change_this_to_a_32_character_key

# ============================================
# 业务配置
# ============================================
# 每日使用限制
MAX_MESSAGES_PER_DAY=100
MAX_AUDIO_MINUTES_PER_DAY=60

# 情感风险阈值
EMOTION_RISK_HIGH=0.8
EMOTION_RISK_MEDIUM=0.5

# 紧急警报配置
ALERT_EMAIL=admin@example.com
ALERT_PHONE=+86-138-0013-8000

# Slack通知（可选）
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_FILE_PATH=/var/log/ai-companion/app.log

# ============================================
# 前端配置
# ============================================
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# ============================================
# 开发/生产环境
# ============================================
ENVIRONMENT=development  # development, staging, production
DEBUG=true
